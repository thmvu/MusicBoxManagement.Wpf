<Window x:Class="MusicBoxManagement.Wpf.Views.AccountsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Tài khoản nhân viên" Width="1160" Height="760" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterOwner" Background="#F2F4F5" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,12"/></Style><Style TargetType="PasswordBox" BasedOn="{StaticResource FormPasswordBox}"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,0,10"/></Style></Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/><TextBlock Text="Tài khoản nhân viên" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button x:Name="ReloadButton" Content="Làm mới" Click="Reload_Click" IsEnabled="{Binding CanReload}" Margin="0,0,10,0"/><Button x:Name="NewButton" Content="Thêm nhân viên" Click="New_Click" IsEnabled="{Binding CanNew}"/></WrapPanel>
    <DataGrid x:Name="AccountsTable" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected,Mode=OneWay}" SelectionChanged="Selection_Changed" IsEnabled="{Binding CanSelect}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="38" Background="White" BorderBrush="#CAD3D8" SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
     <DataGrid.Columns><DataGridTextColumn Header="Đăng nhập" Binding="{Binding UserName}" Width="145"/><DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" MinWidth="110"/><DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="80"/><DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive,Mode=OneWay}" Width="80"/></DataGrid.Columns>
    </DataGrid>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Visibility="{Binding HasForm,Converter={StaticResource Visible}}">
    <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
    <StackPanel IsEnabled="{Binding CanInput}"><TextBlock Text="Tên đăng nhập"/><TextBox x:Name="NameInput" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/><TextBlock Text="Họ tên"/><TextBox Text="{Binding FullName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
     <TextBlock Text="Vai trò"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" IsEnabled="{Binding CanChangeRoleState}" Padding="7" Margin="0,5,0,12"/><CheckBox Content="Tài khoản đang hoạt động (bỏ chọn để khóa)" IsChecked="{Binding IsActive}" IsEnabled="{Binding CanChangeRoleState}" Margin="0,0,0,14"/>
    </StackPanel>
    <StackPanel Visibility="{Binding NeedsPassword,Converter={StaticResource Visible}}" IsEnabled="{Binding CanPassword}"><TextBlock Text="Mật khẩu mới (8–128 ký tự)"/><PasswordBox x:Name="PasswordInput" MaxLength="128"/><TextBlock Text="Nhập lại mật khẩu"/><PasswordBox x:Name="RepeatInput" MaxLength="128"/></StackPanel>
    <WrapPanel Margin="0,8,0,12"><Button x:Name="PrepareButton" Content="Kiểm tra / Lưu" Click="Prepare_Click" IsEnabled="{Binding CanPrepare}" Margin="0,0,8,8"/><Button x:Name="ResetButton" Content="Reset mật khẩu" Click="Reset_Click" IsEnabled="{Binding CanReset}" Margin="0,0,0,8"/></WrapPanel>
    <StackPanel Visibility="{Binding IsConfirming,Converter={StaticResource Visible}}"><TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Xác nhận lưu" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Margin="0,0,8,8"/><Button x:Name="KeepButton" Content="Quay lại" Click="Keep_Click" IsEnabled="{Binding CanConfirm}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,16,0,0"/>
 </Grid>
</Window>
