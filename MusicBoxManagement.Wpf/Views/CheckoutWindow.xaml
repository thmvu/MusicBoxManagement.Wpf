<Window x:Class="MusicBoxManagement.Wpf.Views.CheckoutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Trả phòng" Width="1140" Height="740" MinWidth="1000" MinHeight="640"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click" IsEnabled="{Binding CanClose}"/><TextBlock Text="Trả phòng và thanh toán" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,20">
   <ComboBox x:Name="SessionInput" Width="480" ItemsSource="{Binding Sessions}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanChoose}" Padding="8" Margin="0,0,12,8"/>
   <Button x:Name="ReloadButton" Content="Tải lại phiên" Click="Reload_Click" IsEnabled="{Binding CanReload}" Margin="0,0,12,8"/>
   <Button x:Name="PreviewButton" Content="Tính tiền / Cập nhật" Click="Preview_Click" IsEnabled="{Binding CanPreview}" Margin="0,0,0,8"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,24,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,18"/>
    <TextBlock Grid.Row="1" Text="Món đã phục vụ được cộng tiền" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <DataGrid x:Name="ItemsTable" Grid.Row="2" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="40" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
     <DataGrid.Resources><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}"><Setter Property="Background" Value="#E9EEF0"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridTextColumn Header="Đơn" Binding="{Binding OrderId}" Width="55"/>
      <DataGridTextColumn Header="Món" Binding="{Binding Name}" Width="*" MinWidth="120"/>
      <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="45"/>
      <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="100"/>
      <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" Width="110"/></DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Grid Grid.Column="1" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ConfirmationScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="{Binding Amounts}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="30"/>
     <TextBlock Text="{Binding PendingWarning}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="23"/>
     <TextBlock Text="Tổng cuối tính lại cả thời gian chờ và món mới phục vụ. Hãy đối chiếu tiền đã nhận trước khi xác nhận." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,10,0,14" LineHeight="23"/>
     <TextBlock Text="Hình thức nhận tiền" FontWeight="SemiBold"/>
     <ComboBox x:Name="PaymentInput" SelectedValuePath="Tag" SelectedValue="{Binding PaymentMethod}" IsEnabled="{Binding CanClose}" Padding="8" Margin="0,6,0,10">
      <ComboBoxItem Tag="Cash" Content="Tiền mặt"/><ComboBoxItem Tag="BankTransfer" Content="Chuyển khoản"/>
     </ComboBox>
     <CheckBox x:Name="AcknowledgementInput" IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanClose}"><TextBlock Text="Tôi đã kiểm tra và nhận tiền từ khách." TextWrapping="Wrap"/></CheckBox>
    </StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" Margin="0,18,0,0"><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Xác nhận đã thu tiền" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Margin="0,0,8,8"/><Button x:Name="KeepButton" Content="Quay lại" Click="Keep_Click" IsEnabled="{Binding CanClose}" Margin="0,0,0,8"/></WrapPanel>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasReceipt, Converter={StaticResource Visible}}"><Border BorderBrush="#CAD3D8" BorderThickness="1" Background="White" Padding="18"><TextBlock x:Name="ReceiptText" Text="{Binding ReceiptText}" TextWrapping="Wrap" LineHeight="27"/></Border></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,18,0,0"/>
 </Grid>
</Window>
