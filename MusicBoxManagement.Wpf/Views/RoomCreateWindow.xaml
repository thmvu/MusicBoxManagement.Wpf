<Window x:Class="MusicBoxManagement.Wpf.Views.RoomCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Thêm phòng" Width="590" Height="720" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Thêm phòng" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Phòng mới được mở để sử dụng. Mã phòng sẽ giữ cố định sau khi tạo."
                       Margin="0,8,0,0" Foreground="#5C6873" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding CanOperate}" Margin="0,0,12,0">
                <TextBlock Text="Mã phòng (bắt buộc)" Margin="0,0,0,6" />
                <TextBox x:Name="CodeInput" Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8" />
                <TextBlock Text="Tên phòng (bắt buộc)" Margin="0,16,0,6" />
                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8" />
                <TextBlock Text="Loại phòng (bắt buộc)" Margin="0,16,0,6" />
                <ComboBox x:Name="TypeInput" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}"
                          DisplayMemberPath="Name" Padding="8" />
                <TextBlock Text="Ảnh phòng (bắt buộc)" Margin="0,16,0,6" />
                <DockPanel>
                    <Button x:Name="ChooseImageButton" Content="Chọn ảnh…" Click="ChooseImage_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox x:Name="ImagePathInput" Text="{Binding ImageFilePath, Mode=OneWay}" IsReadOnly="True" Padding="8" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Một ảnh JPEG, PNG hoặc WebP hợp lệ, tối đa 5 MB." FontSize="12" Foreground="#5C6873" Margin="0,6,0,0" />
                <TextBlock Text="Mô tả" Margin="0,16,0,6" />
                <TextBox x:Name="DescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                         Padding="8" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8B2929" Margin="0,16,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Thêm phòng" IsEnabled="{Binding CanOperate}" Click="Save_Click" />
            <Button x:Name="CancelButton" Content="Hủy" IsCancel="True" IsEnabled="{Binding CanOperate}" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
