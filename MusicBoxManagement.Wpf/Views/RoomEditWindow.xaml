<Window x:Class="MusicBoxManagement.Wpf.Views.RoomEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Sửa phòng" Width="590" Height="800" MinWidth="520" MinHeight="580"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Sửa phòng" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RoomCode, StringFormat=Mã phòng: {0}}" Margin="0,8,0,0" Foreground="#5C6873" />
            <TextBlock Text="{Binding RoomTypeName, StringFormat=Loại phòng lúc mở form: {0}}" Margin="0,4,0,0" Foreground="#5C6873" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding CanSave}" Margin="0,0,12,0">
                <TextBlock Text="Tên phòng (bắt buộc)" Margin="0,0,0,6" />
                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8" />
                <TextBlock Text="Loại phòng" Margin="0,16,0,6" />
                <ComboBox x:Name="TypeInput" ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" DisplayMemberPath="Name" Padding="8" />
                <CheckBox x:Name="ActiveInput" Content="Mở phòng để nhận khách" IsChecked="{Binding IsActive}" Margin="0,16,0,8" />
                <TextBlock Text="Lý do khóa (bắt buộc khi bỏ chọn mở phòng)" Margin="0,0,0,6" TextWrapping="Wrap" />
                <TextBox x:Name="ReasonInput" Text="{Binding InactiveReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Padding="8" />
                <TextBlock Text="Thay ảnh phòng" Margin="0,16,0,6" />
                <DockPanel>
                    <Button x:Name="ChooseImageButton" Content="Chọn ảnh…" Click="ChooseImage_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ReplacementImageFilePath, Mode=OneWay}" IsReadOnly="True" Padding="8" VerticalContentAlignment="Center" />
                </DockPanel>
                <Button x:Name="KeepImageButton" Content="Giữ ảnh hiện tại" Click="KeepImage_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                <TextBlock Text="Không chọn ảnh mới thì giữ ảnh hiện tại. JPEG/PNG/WebP, tối đa 5 MB." FontSize="12" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,8,0,0" />
                <TextBlock Text="Mô tả" Margin="0,16,0,6" />
                <TextBox x:Name="DescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                         Padding="8" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8B2929" Margin="0,16,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Lưu thay đổi" IsEnabled="{Binding CanSave}" Click="Save_Click" />
            <Button x:Name="CancelButton" Content="Hủy" IsCancel="True" IsEnabled="{Binding CanSave}" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
