<Window x:Class="MusicBoxManagement.Wpf.Views.CustomerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicBoxManagement.Wpf.Views"
        Title="Music Box — Lịch sử khách hàng" Width="1180" Height="720" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5" Loaded="Window_Loaded">
    <Window.Resources>
        <local:HistoryTimeConverter x:Key="LocalTime" />
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="MinRowHeight" Value="42" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CAD3D8" />
            <Setter Property="AlternatingRowBackground" Value="#F7F9FA" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE4E7" />
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="#E9EEF0" /></Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="10,6" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                <Button x:Name="ReloadButton" Content="Tải lại" Click="Reload_Click" IsEnabled="{Binding CanReload}" />
                <Button x:Name="CloseButton" Content="Đóng" IsCancel="True" IsEnabled="{Binding CanReload}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel><TextBlock Text="Lịch sử khách hàng" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="CustomerText" Text="{Binding CustomerLabel}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,16,0,16" FontWeight="SemiBold" />
        <TabControl Grid.Row="2" x:Name="HistoryTabs">
            <TabItem Header="Booking">
                <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="{Binding BookingNotice}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#5C6873" />
                    <DataGrid x:Name="BookingsTable" ItemsSource="{Binding History.Reservations}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding ReservationId}" Width="65" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Phòng" Binding="{Binding RoomCode}" Width="100" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartTime, Converter={StaticResource LocalTime}}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndTime, Converter={StaticResource LocalTime}}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Trạng thái lưu" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Lý do hủy" Binding="{Binding CancellationReason}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Phiên sử dụng">
                <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="{Binding SessionNotice}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#5C6873" />
                    <DataGrid x:Name="SessionsTable" ItemsSource="{Binding History.Sessions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phiên" Binding="{Binding RoomSessionId}" Width="65" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Booking nguồn" Binding="{Binding ReservationId, TargetNullValue=Walk-in}" Width="115" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Phòng đã chốt" Binding="{Binding RoomCodeSnapshot}" Width="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Loại đã chốt" Binding="{Binding RoomTypeNameSnapshot}" Width="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Giá/giờ (đ)" Binding="{Binding HourlyRate, StringFormat=N0}" Width="125" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Nhận thực tế" Binding="{Binding ActualStartTime, Converter={StaticResource LocalTime}}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Trả dự kiến" Binding="{Binding ExpectedEndTime, Converter={StaticResource LocalTime}}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Trả thực tế" Binding="{Binding ActualEndTime, Converter={StaticResource LocalTime}}" Width="175" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Hóa đơn">
                <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" x:Name="InvoiceNoticeText" Text="{Binding InvoiceNotice}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#5C6873" />
                    <DataGrid x:Name="InvoicesTable" ItemsSource="{Binding History.Invoices}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số hóa đơn" Binding="{Binding InvoiceNumber}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Phòng đã chốt" Binding="{Binding RoomCode}" Width="130" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Thanh toán lúc" Binding="{Binding PaidLabel}" Width="180" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Phương thức" Binding="{Binding PaymentLabel}" Width="150" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat=N0}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,14,0,0" />
    </Grid>
</Window>
