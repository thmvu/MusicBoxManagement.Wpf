<Window x:Class="MusicBoxManagement.Wpf.Views.SessionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Phiên sử dụng" Width="1200" Height="760" MinWidth="1000" MinHeight="640"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Phiên sử dụng" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>
  <WrapPanel Grid.Row="1" Margin="0,0,0,20" IsEnabled="{Binding CanSearch}">
   <StackPanel Margin="0,0,16,0"><TextBlock Text="SĐT đầy đủ (bỏ trống để xem tất cả)"/><TextBox x:Name="PhoneQueryInput" Width="280" Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="Trạng thái"/><ComboBox x:Name="StatusInput" Width="140" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusQuery}" Padding="8" Margin="0,6,0,0"/></StackPanel>
   <Button x:Name="SearchButton" Content="Cập nhật / Tìm" Click="Search_Click" VerticalAlignment="Bottom"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="SessionsTable" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelect}" Margin="0,0,24,0"
    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="40" SelectionMode="Single" SelectionUnit="FullRow" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
    <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E9EEF0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
     <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
    <DataGrid.Columns><DataGridTextColumn Header="Phiên" Binding="{Binding Session.RoomSessionId}" Width="65"/>
     <DataGridTextColumn Header="Phòng" Binding="{Binding Session.RoomCodeSnapshot}" Width="80"/><DataGridTextColumn Header="Khách" Binding="{Binding CustomerName}" Width="*" MinWidth="150"/>
     <DataGridTextColumn Header="SĐT" Binding="{Binding PhoneNumber}" Width="115"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Session.Status}" Width="100"/></DataGrid.Columns>
   </DataGrid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="23"/>
    <Button x:Name="BillButton" Content="Xem tiền tạm tính" Click="Bill_Click" IsEnabled="{Binding CanOpenBill}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    <StackPanel Margin="0,20,0,0" IsEnabled="{Binding CanSelect}"><TextBlock Text="Gia hạn phiên từ booking" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0">
     <ComboBox x:Name="MinutesInput" Width="85" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding Minutes}" Padding="8" Margin="0,0,8,0"/>
     <Button x:Name="ExtendButton" Content="Gia hạn (phút)" IsEnabled="{Binding CanExtend}" Click="Extend_Click"/></WrapPanel></StackPanel>
    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="23"/>
    <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}">
     <Button x:Name="ConfirmButton" Content="Xác nhận gia hạn" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" Margin="0,0,8,8"/>
     <Button x:Name="KeepButton" Content="Để sau" IsEnabled="{Binding CanClose}" Click="Keep_Click" Margin="0,0,0,8"/>
    </WrapPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,18,0,0"/>
 </Grid>
</Window>
