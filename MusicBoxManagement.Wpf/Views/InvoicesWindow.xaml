<Window x:Class="MusicBoxManagement.Wpf.Views.InvoicesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="Music Box — Hóa đơn" Width="1280" Height="800" MinWidth="1120" MinHeight="700"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/>
  <Style TargetType="{x:Type primitives:DatePickerTextBox}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
   <Grid Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    <TextBlock x:Name="DateHint" Text="Chọn ngày" Foreground="#5C6873" VerticalAlignment="Center" Margin="4,0" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="DateHint" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DateHint" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CAD3D8"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#DEE4E7"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E9EEF0"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="*" MinHeight="235"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click" IsEnabled="{Binding CanSearch}"/><TextBlock Text="Hóa đơn đã thanh toán" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanSearch}">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Mã hóa đơn đầy đủ"/><TextBox x:Name="NumberInput" Width="215" Text="{Binding NumberQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,6,0,0" MaxLength="50"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Từ ngày thanh toán"/><DatePicker x:Name="FromInput" Width="160" SelectedDate="{Binding FromDate}" Margin="0,6,0,0" Padding="6"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Đến ngày thanh toán"/><DatePicker x:Name="ToInput" Width="160" SelectedDate="{Binding ToDate}" Margin="0,6,0,0" Padding="6"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="SĐT hiện hành đầy đủ"/><TextBox x:Name="PhoneInput" Width="185" Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,6,0,0" MaxLength="50"/></StackPanel>
   <Button x:Name="SearchButton" Content="Tìm / Cập nhật" Click="Search_Click" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
   <Button x:Name="ClearButton" Content="Xóa lọc" Click="Clear_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <DataGrid x:Name="InvoicesTable" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=OneWay}" SelectionChanged="Selection_Changed" IsEnabled="{Binding CanSelect}" SelectionMode="Single" SelectionUnit="FullRow">
   <DataGrid.Columns><DataGridTextColumn Header="Mã hóa đơn" Binding="{Binding InvoiceNumber}" Width="215"/><DataGridTextColumn Header="Phòng" Binding="{Binding RoomCode}" Width="85"/>
    <DataGridTextColumn Header="Thanh toán (giờ Việt Nam)" Binding="{Binding PaidLabel}" Width="225"/><DataGridTextColumn Header="Hình thức" Binding="{Binding PaymentLabel}" Width="145"/>
    <DataGridTextColumn Header="Tổng tiền (đ)" Binding="{Binding TotalAmount, StringFormat=N0}" Width="*" MinWidth="140"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="3" Text="Chọn hóa đơn để xem thông tin phòng, món đã phục vụ và tổng tiền đã chốt." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,18,0,0" Visibility="{Binding ShowHint, Converter={StaticResource Visible}}"/>
  <Grid Grid.Row="3" Margin="0,16,0,0" Visibility="{Binding HasDetails, Converter={StaticResource Visible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="355"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,20,0"><TextBlock x:Name="DetailText" Text="{Binding DetailText}" TextWrapping="Wrap" LineHeight="24"/></ScrollViewer>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="AmountsText" Text="{Binding Amounts}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" LineHeight="28" Margin="0,0,0,12"/>
    <DataGrid x:Name="ItemsTable" Grid.Row="1" ItemsSource="{Binding Lines}"><DataGrid.Columns>
     <DataGridTextColumn Header="Đơn" Binding="{Binding OrderId}" Width="55"/><DataGridTextColumn Header="Món đã phục vụ" Binding="{Binding ServiceNameSnapshot}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="45"/><DataGridTextColumn Header="Đơn giá (đ)" Binding="{Binding UnitPrice, StringFormat=N0}" Width="190"/><DataGridTextColumn Header="Thành tiền (đ)" Binding="{Binding Amount, StringFormat=N0}" Width="220"/>
    </DataGrid.Columns></DataGrid>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#5C6873" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </Grid>
</Window>
