<Window x:Class="MusicBoxManagement.Wpf.Views.AuthenticationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Tài khoản nhân viên" Width="510" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
    <StackPanel Margin="32">
        <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="Description" Margin="0,8,0,24" TextWrapping="Wrap" Foreground="#5C6873" />
        <StackPanel x:Name="Fields">
            <TextBlock Text="Tên đăng nhập" Margin="0,0,0,6" />
            <TextBox x:Name="UserNameBox" AutomationProperties.AutomationId="UserNameBox" MaxLength="100" Padding="8" />
            <StackPanel x:Name="FullNameFields" Margin="0,14,0,0">
                <TextBlock Text="Họ tên Admin" Margin="0,0,0,6" />
                <TextBox x:Name="FullNameBox" AutomationProperties.AutomationId="FullNameBox" MaxLength="100" Padding="8" />
            </StackPanel>
            <TextBlock Text="Mật khẩu" Margin="0,14,0,6" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.AutomationId="PasswordInput" MaxLength="128" Padding="8" />
            <StackPanel x:Name="ConfirmationFields" Margin="0,14,0,0">
                <TextBlock Text="Nhập lại mật khẩu" Margin="0,0,0,6" />
                <PasswordBox x:Name="ConfirmInput" AutomationProperties.AutomationId="ConfirmInput" MaxLength="128" Padding="8" />
                <TextBlock Text="Mật khẩu từ 8–128 ký tự. Không có mật khẩu mặc định." FontSize="12"
                           Foreground="#5C6873" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="AuthStatus" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#8B2929" />
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="SubmitButton" AutomationProperties.AutomationId="SubmitAuth" IsDefault="True" Click="Submit_Click" />
            <Button x:Name="CancelButton" Content="Về chế độ Khách" IsCancel="True" Grid.Column="1" Margin="12,0,0,0" />
        </Grid>
    </StackPanel>
</Window>
