<Window x:Class="MusicBoxManagement.Wpf.Views.PermissionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Ma trận quyền" Width="1120" Height="780" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#F2F4F5" FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/><TextBlock Text="Ma trận quyền nhân viên" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,16">
   <TextBlock Text="Admin luôn toàn quyền. Chỉ chỉnh quyền theo vai trò Staff/Manager, không gán riêng từng người." TextWrapping="Wrap" Foreground="#41535F" Margin="0,0,0,10"/>
   <WrapPanel VerticalAlignment="Center"><TextBlock Text="Vai trò" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="RoleInput" Width="160" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole,Mode=TwoWay}" IsEnabled="{Binding CanReload}" Margin="0,0,12,0"/><Button x:Name="ReloadButton" Content="Làm mới" Click="Reload_Click" IsEnabled="{Binding CanReload}"/><TextBlock Text="In hóa đơn cần quyền xem; xuất Excel cần quyền xem báo cáo." TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,6,0,0"/></WrapPanel>
  </StackPanel>
  <DataGrid Grid.Row="2" x:Name="PermissionsTable" ItemsSource="{Binding Rows}" IsEnabled="{Binding CanInput}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="34" ColumnHeaderHeight="38" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Cho phép" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsGranted,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Chức năng" Binding="{Binding Name}" Width="*" MinWidth="220"/>
    <DataGridTextColumn Header="Mã quyền" Binding="{Binding Code}" Width="220"/>
    <DataGridTextColumn Header="Giới hạn" Binding="{Binding Restriction}" Width="170"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="3" Margin="0,14,0,0">
   <Border Padding="12" Background="#E3EBEF" Visibility="{Binding HasConfirmation,Converter={StaticResource Visible}}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="Xác nhận lưu" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}" Margin="0,0,10,0"/><Button x:Name="KeepButton" Content="Quay lại" Click="Keep_Click" IsEnabled="{Binding CanReload}"/></WrapPanel></StackPanel></Border>
   <WrapPanel><Button x:Name="PrepareButton" Content="Kiểm tra / Lưu" Click="Prepare_Click" IsEnabled="{Binding CanSave}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="720" Margin="14,6,0,0" Foreground="#263D4A"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
