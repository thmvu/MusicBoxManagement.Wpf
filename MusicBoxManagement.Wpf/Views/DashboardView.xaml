<UserControl x:Class="MusicBoxManagement.Wpf.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="vi-VN">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate x:Key="Line"><StackPanel Margin="10,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="#5C6873" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate>
  <Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DEE2"/><Setter Property="ItemTemplate" Value="{StaticResource Line}"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
  <DataTemplate x:Key="RoomTile">
   <Border Width="216" MinHeight="106" Margin="0,0,12,12" Background="White" BorderBrush="#D5DEE2" BorderThickness="1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#66757F"/><Style.Triggers>
      <DataTrigger Binding="{Binding StatusCode}" Value="Available"><Setter Property="Background" Value="#2B6B67"/></DataTrigger>
      <DataTrigger Binding="{Binding StatusCode}" Value="Occupied"><Setter Property="Background" Value="#476483"/></DataTrigger>
      <DataTrigger Binding="{Binding StatusCode}" Value="Reserved"><Setter Property="Background" Value="#A57533"/></DataTrigger>
     </Style.Triggers></Style></Border.Style></Border>
     <StackPanel Grid.Column="1" Margin="14,12"><DockPanel><TextBlock Text="{Binding StatusLabel}" DockPanel.Dock="Right" FontSize="12" Foreground="#5C6873" VerticalAlignment="Center"/><TextBlock Text="{Binding Code}" FontSize="21" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
  <StackPanel>
   <Border Background="White" BorderBrush="#D5DEE2" BorderThickness="1" Padding="16,12">
    <UniformGrid Columns="4">
     <StackPanel><TextBlock Text="Phòng trống" Foreground="#5C6873"/><TextBlock Text="{Binding AvailableRoomCount}" Style="{StaticResource Metric}" Foreground="#2B6B67"/></StackPanel>
     <StackPanel><TextBlock Text="Đang sử dụng" Foreground="#5C6873"/><TextBlock Text="{Binding OccupiedRoomCount}" Style="{StaticResource Metric}"/></StackPanel>
     <StackPanel><TextBlock Text="Booking hôm nay" Foreground="#5C6873"/><TextBlock Text="{Binding BookingCount}" Style="{StaticResource Metric}"/></StackPanel>
     <StackPanel><TextBlock Text="Đơn món chờ" Foreground="#5C6873"/><TextBlock Text="{Binding PendingOrderCount}" Style="{StaticResource Metric}"/></StackPanel>
    </UniformGrid>
   </Border>
   <DockPanel Margin="0,14,0,14">
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Cập nhật tổng quan" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" Margin="12,0,0,0" VerticalAlignment="Center"/>
    <StackPanel><TextBlock x:Name="RevenueText" Text="{Binding Revenue}" Visibility="{Binding HasRevenue, Converter={StaticResource Visible}}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Updated}" Foreground="#5C6873" Margin="0,5,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="StatsText" Text="{Binding Summary}" FontSize="12" Foreground="#5C6873" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>
   <TextBlock Text="{Binding AlertHeading}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <Grid Margin="0,0,0,16">
    <ListBox x:Name="AlertsList" ItemsSource="{Binding Alerts}" MaxHeight="112" MinHeight="36"/>
    <TextBlock Text="Chưa có cảnh báo tại thời điểm cập nhật." Margin="12,10" Foreground="#5C6873" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Alerts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <TabControl MinHeight="238" BorderBrush="#D5DEE2" Background="White" Padding="12">
    <TabItem Header="Tình trạng phòng">
     <Grid><ItemsControl x:Name="RoomBoard" ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource RoomTile}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <TextBlock Text="Chưa có phòng để hiển thị. Người có quyền quản lý phòng có thể thêm phòng trong Danh mục." TextWrapping="Wrap" Foreground="#5C6873" Margin="12,20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rooms.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
    </TabItem>
    <TabItem Header="Booking hôm nay"><ListBox ItemsSource="{Binding Bookings}" MaxHeight="320" BorderThickness="0"/></TabItem>
    <TabItem Header="Phiên đang dùng"><ListBox ItemsSource="{Binding Sessions}" MaxHeight="320" BorderThickness="0"/></TabItem>
    <TabItem Header="Đơn món chờ"><ListBox ItemsSource="{Binding Orders}" MaxHeight="320" BorderThickness="0"/></TabItem>
   </TabControl>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,12,0,0" FontSize="12"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
