<Window x:Class="MusicBoxManagement.Wpf.Views.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Danh mục phòng" Width="980" Height="640" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5"
        Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AddRoomButton" Content="Thêm phòng" Click="AddRoom_Click" IsEnabled="{Binding CanAddRoom}" />
                <Button x:Name="RefreshButton" Content="Làm mới" Click="Refresh_Click" IsEnabled="{Binding CanOperate}" Margin="8,0,0,0" />
                <Button Content="Đóng" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Danh mục phòng" FontSize="28" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="Mở/khóa là trạng thái danh mục. Lịch trống/bận sẽ có ở bước đặt phòng."
                   Foreground="#5C6873" TextWrapping="Wrap" Margin="0,10,0,20" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
            <DataGrid x:Name="RoomsTable" ItemsSource="{Binding Rooms}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionChanged="Room_SelectionChanged"
                      HeadersVisibility="Column" RowHeight="48" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8"
                      AlternatingRowBackground="#F7F9FA" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="10,0" /></Style>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="#E9EEF0" /></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phòng" Binding="{Binding RoomCode}" Width="100" />
                    <DataGridTextColumn Header="Tên phòng" Binding="{Binding Name}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="Loại phòng" Binding="{Binding RoomTypeName}" Width="150" />
                    <DataGridTextColumn Header="Mở / khóa" Binding="{Binding ActiveLabel}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Ảnh phòng" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Border Background="White" BorderBrush="#CAD3D8" BorderThickness="1" Height="180">
                    <Image x:Name="RoomImage" Stretch="Uniform" Margin="6" />
                </Border>
                <TextBlock x:Name="RoomDescription" Text="Chọn một phòng để xem ảnh và mô tả." TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#5C6873" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="{Binding Status}" Foreground="#5C6873" Margin="0,18,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
