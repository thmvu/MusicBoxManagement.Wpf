<Window x:Class="MusicBoxManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Quản lý phòng" Width="1180" Height="720"
        MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
        Background="#F2F4F5" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#26313B">
            <Grid Margin="24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Music Box" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Quản lý phòng và dịch vụ" FontSize="12" Foreground="#C1CDD4" Margin="0,6,0,36" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="1" Background="#3B4B57" BorderBrush="#90A79C" BorderThickness="3,0,0,0" Padding="14,12">
                    <TextBlock x:Name="CurrentAreaText" Text="Loại phòng" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Row="3">
                    <Separator Background="#51616D" Margin="0,0,0,16" />
                    <TextBlock x:Name="ModeText" Text="Chế độ Khách" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button x:Name="LoginButton" AutomationProperties.AutomationId="OpenLogin" Content="Đăng nhập nhân viên" IsEnabled="False"
                            Click="Login_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <Button x:Name="LogoutButton" AutomationProperties.AutomationId="Logout" Content="Đăng xuất về Khách" Visibility="Collapsed"
                            Click="Logout_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <TextBlock Text="Dữ liệu lưu trên máy" Foreground="#C1CDD4" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="GuestPanel" Grid.Column="1" Margin="36,32,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Loại phòng" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditRoomTypeButton" Content="Sửa loại phòng" Visibility="Collapsed" IsEnabled="False" Click="EditRoomType_Click" Margin="0,0,8,0" />
                    <Button Content="Làm mới" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" />
                    <Button x:Name="BackToStaffButton" Content="Nhân viên" Visibility="Collapsed" Click="RefreshAccess_Click" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="Sức chứa, giá theo giờ và tiện ích của Standard và VIP."
                       Foreground="#5C6873" Margin="0,10,0,28" TextWrapping="Wrap" />
            <DataGrid x:Name="RoomTypesTable" Grid.Row="2" ItemsSource="{Binding RoomTypes}" AutoGenerateColumns="False" SelectionChanged="RoomType_SelectionChanged"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7"
                      BorderBrush="#CAD3D8" Background="White" RowBackground="White"
                      AlternatingRowBackground="#F7F9FA" RowHeight="64" ColumnHeaderHeight="42"
                      SelectionMode="Single" SelectionUnit="FullRow" VerticalAlignment="Stretch">
                <DataGrid.Resources>
                    <Style x:Key="TableText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="14,0" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E9EEF0" />
                        <Setter Property="Foreground" Value="#3D4D58" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#CAD3D8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCE8E2" />
                                <Setter Property="Foreground" Value="#26313B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loại phòng" Binding="{Binding Name}" Width="120" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity, StringFormat={}{0} người}" Width="105" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Giá / giờ" Binding="{Binding PricePerHour, StringFormat={}{0:N0} đ}" Width="130" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Tiện ích" Binding="{Binding Amenities}" Width="*" MinWidth="240" ElementStyle="{StaticResource TableText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5C6873" Margin="0,18,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="StaffPanel" Grid.Column="1" Margin="36,32,36,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Khu vực nhân viên" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="StaffIdentity" AutomationProperties.AutomationId="StaffIdentity" Grid.Row="1" Margin="0,10,0,18" TextWrapping="Wrap" />
            <DockPanel Grid.Row="2" Margin="0,0,0,18">
                <Button x:Name="RefreshAccessButton" Content="Kiểm tra lại quyền" Click="RefreshAccess_Click" DockPanel.Dock="Right" />
                <Button x:Name="RoomTypesButton" Content="Loại phòng" Click="ShowRoomTypes_Click" Visibility="Collapsed" DockPanel.Dock="Right" Margin="0,0,8,0" />
                <Button x:Name="RoomsButton" Content="Phòng" Click="ShowRooms_Click" Visibility="Collapsed" DockPanel.Dock="Right" Margin="0,0,8,0" />
                <TextBlock Text="Quyền hiện hành" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="PermissionsTable" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      RowHeight="36" ColumnHeaderHeight="36" Background="White" BorderBrush="#CAD3D8"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7" AlternatingRowBackground="#F7F9FA">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E9EEF0" />
                        <Setter Property="Foreground" Value="#3D4D58" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,8" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="12,0" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Chức năng" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="Mã quyền" Binding="{Binding Key}" Width="210" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="AccessStatus" Grid.Row="4" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#5C6873"
                       Text="Đã có đăng nhập và kiểm tra quyền. Các màn hình nghiệp vụ sẽ được triển khai ở các bước tiếp theo." />
        </Grid>
    </Grid>
</Window>
