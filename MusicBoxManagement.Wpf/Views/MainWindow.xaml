<Window x:Class="MusicBoxManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Quản lý phòng" Width="1280" Height="760"
        MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
        Background="#F2F4F5" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3F6F8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3B4B57"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#445860"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#A8C2B5"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="#26313B">
            <Grid Margin="20,28,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Music Box" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Quản lý phòng và dịch vụ" FontSize="12" Foreground="#C1CDD4" Margin="0,6,0,24" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="CurrentAreaText" Text="Loại phòng" Foreground="#C1CDD4" FontSize="12" Margin="12,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel x:Name="GuestNavigation">
                            <Button x:Name="BookingButton" Style="{StaticResource SidebarButton}" Content="Đặt phòng" Click="ShowBooking_Click"/>
                            <Button x:Name="LookupButton" Style="{StaticResource SidebarButton}" Content="Tra cứu SĐT" Click="ShowLookup_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="StaffNavigation" Visibility="Collapsed">
                            <Button x:Name="RoomTypesButton" Style="{StaticResource SidebarButton}" Content="Loại phòng" Click="ShowRoomTypes_Click" Visibility="Collapsed"/>
                            <Button x:Name="RoomsButton" Style="{StaticResource SidebarButton}" Content="Phòng" Click="ShowRooms_Click" Visibility="Collapsed"/>
                            <Button x:Name="ServicesButton" Style="{StaticResource SidebarButton}" Content="Dịch vụ" Click="ShowServices_Click" Visibility="Collapsed"/>
                            <Button x:Name="CustomersButton" Style="{StaticResource SidebarButton}" Content="Khách hàng" Click="ShowCustomers_Click" Visibility="Collapsed"/>
                            <Button x:Name="ReservationsButton" Style="{StaticResource SidebarButton}" Content="Booking" Click="ShowReservations_Click" Visibility="Collapsed"/>
                            <Button x:Name="StaffBookingButton" Style="{StaticResource SidebarButton}" Content="Đặt hộ" Click="ShowStaffBooking_Click" Visibility="Collapsed"/>
                            <Button x:Name="WalkInButton" Style="{StaticResource SidebarButton}" Content="Khách trực tiếp" Click="ShowWalkIn_Click" Visibility="Collapsed"/>
                            <Button x:Name="SessionsButton" Style="{StaticResource SidebarButton}" Content="Phiên sử dụng" Click="ShowSessions_Click" Visibility="Collapsed"/>
                            <Button x:Name="OrdersButton" Style="{StaticResource SidebarButton}" Content="Đơn món" Click="ShowOrders_Click" Visibility="Collapsed"/>
                            <Button x:Name="CalendarButton" Style="{StaticResource SidebarButton}" Content="Lịch phòng" Click="ShowCalendar_Click" Visibility="Collapsed"/>
                            <Separator Background="#51616D" Margin="12,10,12,14"/>
                            <Button x:Name="RefreshAccessButton" Style="{StaticResource SidebarButton}" Content="Kiểm tra lại quyền" Click="RefreshAccess_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="CatalogNavigation">
                            <Button x:Name="EditRoomTypeButton" Style="{StaticResource SidebarButton}" Content="Sửa loại phòng" Visibility="Collapsed" IsEnabled="False" Click="EditRoomType_Click"/>
                            <Button Style="{StaticResource SidebarButton}" Content="Làm mới danh mục" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"/>
                            <Button x:Name="BackToStaffButton" Style="{StaticResource SidebarButton}" Content="Về khu vực nhân viên" Visibility="Collapsed" Click="RefreshAccess_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Separator Background="#51616D" Margin="0,0,0,16" />
                    <TextBlock x:Name="ModeText" Text="Chế độ Khách" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button x:Name="LoginButton" AutomationProperties.AutomationId="OpenLogin" Content="Đăng nhập nhân viên" IsEnabled="False"
                            Click="Login_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <Button x:Name="LogoutButton" AutomationProperties.AutomationId="Logout" Content="Đăng xuất về Khách" Visibility="Collapsed"
                            Click="Logout_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <TextBlock Text="Dữ liệu lưu trên máy" Foreground="#C1CDD4" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="GuestPanel" Grid.Column="1" Margin="28,28,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Loại phòng" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Sức chứa, giá theo giờ và tiện ích của Standard và VIP."
                       Foreground="#5C6873" Margin="0,10,0,28" TextWrapping="Wrap" />
            <DataGrid x:Name="RoomTypesTable" Grid.Row="2" ItemsSource="{Binding RoomTypes}" AutoGenerateColumns="False" SelectionChanged="RoomType_SelectionChanged"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7"
                      BorderBrush="#CAD3D8" Background="White" RowBackground="White"
                      AlternatingRowBackground="#F7F9FA" RowHeight="64" ColumnHeaderHeight="42"
                      SelectionMode="Single" SelectionUnit="FullRow" VerticalAlignment="Stretch">
                <DataGrid.Resources>
                    <Style x:Key="TableText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="14,0" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E9EEF0" />
                        <Setter Property="Foreground" Value="#3D4D58" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#CAD3D8" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DCE8E2" />
                                <Setter Property="Foreground" Value="#26313B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loại phòng" Binding="{Binding Name}" Width="120" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity, StringFormat={}{0} người}" Width="105" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Giá / giờ" Binding="{Binding PricePerHour, StringFormat={}{0:N0} đ}" Width="130" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Tiện ích" Binding="{Binding Amenities}" Width="*" MinWidth="240" ElementStyle="{StaticResource TableText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5C6873" Margin="0,18,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="StaffPanel" Grid.Column="1" Margin="28,28,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Khu vực nhân viên" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="StaffIdentity" AutomationProperties.AutomationId="StaffIdentity" Grid.Row="1" Margin="0,10,0,18" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Quyền của tài khoản" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Chọn chức năng trong menu bên trái để mở màn hình làm việc." Foreground="#5C6873" TextWrapping="Wrap"/>
            </StackPanel>
            <DataGrid x:Name="PermissionsTable" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      RowHeight="40" ColumnHeaderHeight="42" Background="White" BorderBrush="#CAD3D8"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7" AlternatingRowBackground="#F7F9FA">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E9EEF0" />
                        <Setter Property="Foreground" Value="#3D4D58" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,8" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="12,0" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Chức năng" Binding="{Binding Value}" Width="*" />
                    <DataGridTextColumn Header="Mã quyền" Binding="{Binding Key}" Width="210" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="AccessStatus" Grid.Row="4" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#5C6873"
                       Text="Menu hiển thị các chức năng được phép sử dụng." />
        </Grid>
    </Grid>
</Window>
