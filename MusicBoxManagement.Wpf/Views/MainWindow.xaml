<Window x:Class="MusicBoxManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:MusicBoxManagement.Wpf.Views"
        Title="Music Box — Quản lý phòng" Width="1280" Height="760"
        MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Language="vi-VN"
        Background="{StaticResource MusicPaperBrush}" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="HeaderTemplate">
                <Setter.Value><DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource MusicNavTextBrush}" FontWeight="SemiBold"/>
                </DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton x:Name="Header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeaderFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="{StaticResource MusicNavMutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" Width="8" Height="8"/>
                                <ContentPresenter Grid.Column="1"/>
                            </Grid></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" CenterX="4" CenterY="4"/></Setter.Value></Setter></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="{StaticResource MusicNavHoverBrush}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="{StaticResource MusicNavMutedBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MusicNavTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource MusicNavHoverBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource MusicNavSelectedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource MusicNavMutedBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{StaticResource MusicInkBrush}">
            <Grid Margin="20,28,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Music Box" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Đặt phòng · Phục vụ · Thanh toán" FontSize="12" Foreground="{StaticResource MusicNavMutedBrush}" Margin="0,6,0,24" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="CurrentAreaText" Text="Loại phòng" Foreground="{StaticResource MusicNavMutedBrush}" FontSize="12" Margin="12,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel x:Name="GuestNavigation">
                            <Button x:Name="BookingButton" Style="{StaticResource SidebarButton}" Content="Đặt phòng" Click="ShowBooking_Click"/>
                            <Button x:Name="LookupButton" Style="{StaticResource SidebarButton}" Content="Tra cứu SĐT" Click="ShowLookup_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="StaffNavigation" Visibility="Collapsed">
                            <Button x:Name="RefreshAccessButton" Content="Tổng quan" Click="RefreshAccess_Click">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarButton}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=StaffPanel}" Value="Visible"><Setter Property="Background" Value="{StaticResource MusicNavSelectedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MusicSageBrush}"/></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <Expander x:Name="OperationsNavigation" Header="Vận hành" IsExpanded="False" Foreground="{StaticResource MusicNavTextBrush}" Margin="0,8,0,0">
                                <StackPanel Margin="8,8,0,0">
                                    <Button x:Name="ReservationsButton" Style="{StaticResource SidebarButton}" Content="Booking" Click="ShowReservations_Click" Visibility="Collapsed"/>
                                    <Button x:Name="StaffBookingButton" Style="{StaticResource SidebarButton}" Content="Đặt hộ" Click="ShowStaffBooking_Click" Visibility="Collapsed"/>
                                    <Button x:Name="WalkInButton" Style="{StaticResource SidebarButton}" Content="Khách trực tiếp" Click="ShowWalkIn_Click" Visibility="Collapsed"/>
                                    <Button x:Name="SessionsButton" Style="{StaticResource SidebarButton}" Content="Phiên sử dụng" Click="ShowSessions_Click" Visibility="Collapsed"/>
                                    <Button x:Name="OrdersButton" Style="{StaticResource SidebarButton}" Content="Đơn món" Click="ShowOrders_Click" Visibility="Collapsed"/>
                                    <Button x:Name="CheckoutButton" Style="{StaticResource SidebarButton}" Content="Trả phòng" Click="ShowCheckout_Click" Visibility="Collapsed"/>
                                    <Button x:Name="InvoicesButton" Style="{StaticResource SidebarButton}" Content="Hóa đơn" Click="ShowInvoices_Click" Visibility="Collapsed"/>
                                    <Button x:Name="CalendarButton" Style="{StaticResource SidebarButton}" Content="Lịch phòng" Click="ShowCalendar_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="CatalogGroup" Header="Danh mục" IsExpanded="False" Foreground="{StaticResource MusicNavTextBrush}" Margin="0,8,0,0">
                                <StackPanel Margin="8,8,0,0">
                                    <Button x:Name="RoomsButton" Style="{StaticResource SidebarButton}" Content="Phòng" Click="ShowRooms_Click" Visibility="Collapsed"/>
                                    <Button x:Name="RoomTypesButton" Style="{StaticResource SidebarButton}" Content="Loại phòng" Click="ShowRoomTypes_Click" Visibility="Collapsed"/>
                                    <Button x:Name="ServicesButton" Style="{StaticResource SidebarButton}" Content="Dịch vụ" Click="ShowServices_Click" Visibility="Collapsed"/>
                                    <Button x:Name="CustomersButton" Style="{StaticResource SidebarButton}" Content="Khách hàng" Click="ShowCustomers_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="ReportsNavigation" Header="Báo cáo" IsExpanded="False" Foreground="{StaticResource MusicNavTextBrush}" Margin="0,8,0,0">
                                <StackPanel Margin="8,8,0,0">
                                    <Button x:Name="ReportsButton" Style="{StaticResource SidebarButton}" Content="Báo cáo doanh thu" Click="ShowReports_Click" Visibility="Collapsed"/>
                                    <Button x:Name="RoomReportsButton" Style="{StaticResource SidebarButton}" Content="Báo cáo sử dụng phòng" Click="ShowRoomReports_Click" Visibility="Collapsed"/>
                                    <Button x:Name="BookingReportsButton" Style="{StaticResource SidebarButton}" Content="Báo cáo đặt phòng" Click="ShowBookingReports_Click" Visibility="Collapsed"/>
                                    <Button x:Name="ServiceReportsButton" Style="{StaticResource SidebarButton}" Content="Doanh thu và top món" Click="ShowServiceReports_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="AdministrationNavigation" Header="Quản trị" IsExpanded="False" Foreground="{StaticResource MusicNavTextBrush}" Margin="0,8,0,0">
                                <StackPanel Margin="8,8,0,0">
                                    <Button x:Name="AccountsButton" Style="{StaticResource SidebarButton}" Content="Nhân viên" Click="ShowAccounts_Click" Visibility="Collapsed"/>
                                    <Button x:Name="PermissionsButton" Style="{StaticResource SidebarButton}" Content="Ma trận quyền" Click="ShowPermissions_Click" Visibility="Collapsed"/>
                                    <Button x:Name="AuditButton" Style="{StaticResource SidebarButton}" Content="Nhật ký" Click="ShowAudit_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="CatalogNavigation">
                            <Button x:Name="EditRoomTypeButton" Style="{StaticResource SidebarButton}" Content="Sửa loại phòng" Visibility="Collapsed" IsEnabled="False" Click="EditRoomType_Click"/>
                            <Button Style="{StaticResource SidebarButton}" Content="Làm mới danh mục" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"/>
                            <Button x:Name="BackToStaffButton" Style="{StaticResource SidebarButton}" Content="Về khu vực nhân viên" Visibility="Collapsed" Click="RefreshAccess_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <Separator Background="{StaticResource MusicNavLineBrush}" Margin="0,0,0,16" />
                    <TextBlock x:Name="ModeText" Text="Chế độ Khách" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button x:Name="LoginButton" AutomationProperties.AutomationId="OpenLogin" Content="Đăng nhập nhân viên" IsEnabled="False"
                            Click="Login_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <Button x:Name="LogoutButton" AutomationProperties.AutomationId="Logout" Content="Đăng xuất về Khách" Visibility="Collapsed"
                            Click="Logout_Click" Padding="8,9" Margin="0,0,0,8" FontSize="12" />
                    <TextBlock Text="09:00–12:00 · 13:00–23:00" Foreground="{StaticResource MusicNavMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="GuestPanel" Grid.Column="1" Margin="28,28,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Loại phòng" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Margin="0,10,0,20">
                <TextBlock Text="Sức chứa, giá theo giờ và tiện ích của Standard và VIP." Foreground="{StaticResource MusicMutedBrush}" TextWrapping="Wrap"/>
                <WrapPanel Visibility="{Binding Visibility, ElementName=GuestNavigation}" Margin="0,16,0,0">
                    <Button x:Name="GuestBookAction" Content="Xem phòng và đặt chỗ" Style="{StaticResource PrimaryButton}" Click="ShowBooking_Click" IsEnabled="{Binding IsEnabled, ElementName=BookingButton}" Margin="0,0,10,6"/>
                    <Button x:Name="GuestLookupAction" Content="Tra cứu booking / Phiên đang dùng" Click="ShowLookup_Click" IsEnabled="{Binding IsEnabled, ElementName=LookupButton}" Margin="0,0,0,6"/>
                </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="RoomTypesTable" Grid.Row="2" ItemsSource="{Binding RoomTypes}" AutoGenerateColumns="False" SelectionChanged="RoomType_SelectionChanged"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource MusicLineBrush}"
                      BorderBrush="{StaticResource MusicLineBrush}" Background="White" RowBackground="White"
                      AlternatingRowBackground="{StaticResource MusicAlternateBrush}" RowHeight="64" ColumnHeaderHeight="42"
                      SelectionMode="Single" SelectionUnit="FullRow" VerticalAlignment="Stretch">
                <DataGrid.Resources>
                    <Style x:Key="TableText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="14,0" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
                        <Setter Property="Background" Value="{StaticResource MusicHeaderBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource MusicInkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource MusicLineBrush}" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource MusicSelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MusicInkBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Loại phòng" Binding="{Binding Name}" Width="120" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity, StringFormat={}{0} người}" Width="105" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Giá / giờ" Binding="{Binding PricePerHour, StringFormat={}{0:N0} đ}" Width="130" ElementStyle="{StaticResource TableText}" />
                    <DataGridTextColumn Header="Tiện ích" Binding="{Binding Amenities}" Width="*" MinWidth="240" ElementStyle="{StaticResource TableText}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{StaticResource MusicMutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="StaffPanel" Grid.Column="1" Margin="28,28,28,24" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StaffHeading" Text="Bảng điều hành" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="StaffIdentity" AutomationProperties.AutomationId="StaffIdentity" Grid.Row="1" Margin="0,10,0,18" TextWrapping="Wrap"/>
            <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                <Button x:Name="QuickWalkInButton" Content="Nhận khách trực tiếp" Style="{StaticResource PrimaryButton}" Click="ShowWalkIn_Click" Visibility="{Binding Visibility, ElementName=WalkInButton}" IsEnabled="{Binding IsEnabled, ElementName=WalkInButton}" Margin="0,0,8,8"/>
                <Button x:Name="QuickBookingButton" Content="Đặt hộ khách" Click="ShowStaffBooking_Click" Visibility="{Binding Visibility, ElementName=StaffBookingButton}" IsEnabled="{Binding IsEnabled, ElementName=StaffBookingButton}" Margin="0,0,8,8"/>
                <Button x:Name="QuickOrdersButton" Content="Xử lý đơn món" Click="ShowOrders_Click" Visibility="{Binding Visibility, ElementName=OrdersButton}" IsEnabled="{Binding IsEnabled, ElementName=OrdersButton}" Margin="0,0,8,8"/>
                <Button x:Name="QuickCheckoutButton" Content="Trả phòng / Thu tiền" Click="ShowCheckout_Click" Visibility="{Binding Visibility, ElementName=CheckoutButton}" IsEnabled="{Binding IsEnabled, ElementName=CheckoutButton}" Margin="0,0,0,8"/>
            </WrapPanel>
            <views:DashboardView x:Name="DashboardHost" Grid.Row="3"/>
            <TextBlock x:Name="AccessStatus" Grid.Row="4" TextWrapping="Wrap" Foreground="{StaticResource MusicMutedBrush}"/>
        </Grid>
    </Grid>
</Window>
