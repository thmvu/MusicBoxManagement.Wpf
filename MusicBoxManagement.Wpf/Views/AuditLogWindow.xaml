<Window x:Class="MusicBoxManagement.Wpf.Views.AuditLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Nhật ký hoạt động" Width="1200" Height="820" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#F2F4F5" FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Đóng" Click="Close_Click"/><TextBlock Text="Nhật ký hoạt động" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanSearch}">
   <StackPanel Margin="0,0,10,8"><TextBlock Text="Từ ngày (giờ Việt Nam)"/><DatePicker x:Name="FromInput" SelectedDate="{Binding FromDate}" Width="155" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,10,8"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToInput" SelectedDate="{Binding ToDate}" Width="155" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,10,8"><TextBlock Text="Người thực hiện"/><ComboBox x:Name="ActorInput" ItemsSource="{Binding ActorTypes}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding ActorType,Mode=TwoWay}" Width="135" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,10,8"><TextBlock Text="Mã hành động đầy đủ"/><TextBox x:Name="ActionInput" Text="{Binding ActionQuery,UpdateSourceTrigger=PropertyChanged}" Width="195" MaxLength="100" Padding="7" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,10,8"><TextBlock Text="Tên đối tượng đầy đủ"/><TextBox x:Name="EntityInput" Text="{Binding EntityQuery,UpdateSourceTrigger=PropertyChanged}" Width="180" MaxLength="100" Padding="7" Margin="0,6,0,0"/></StackPanel>
   <Button x:Name="SearchButton" Content="Tìm / Cập nhật" Click="Search_Click" VerticalAlignment="Bottom" Margin="0,0,8,8"/><Button x:Name="ClearButton" Content="Xóa lọc" Click="Clear_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
   <DataGrid x:Name="AuditTable" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected,Mode=OneWay}" SelectionChanged="Selection_Changed" IsEnabled="{Binding CanSelect}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="34" ColumnHeaderHeight="38" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
    <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding AuditLogId}" Width="65"/><DataGridTextColumn Header="Thời gian Việt Nam" Binding="{Binding CreatedLabel}" Width="190"/><DataGridTextColumn Header="Thực hiện" Binding="{Binding ActorLabel}" Width="90"/><DataGridTextColumn Header="Tài khoản hiện hành" Binding="{Binding UserLabel}" Width="*" MinWidth="170"/><DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="165"/><DataGridTextColumn Header="Đối tượng" Binding="{Binding EntityName}" Width="150"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="1" BorderBrush="#CAD3D8" BorderThickness="1" Background="White" Padding="12" Margin="0,12,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Foreground="#263D4A"/></ScrollViewer></Border>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><WrapPanel><Button x:Name="NextButton" Content="Trang cũ hơn" Click="Next_Click" IsEnabled="{Binding CanNextPage}"/><TextBlock Text="Mỗi trang tối đa 100 bản ghi, sắp theo ID giảm dần. Chỉ xem; không sửa hoặc xóa nhật ký." Margin="14,7,0,0" TextWrapping="Wrap" MaxWidth="720" Foreground="#41535F"/></WrapPanel><TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#263D4A"/></StackPanel>
 </Grid>
</Window>
