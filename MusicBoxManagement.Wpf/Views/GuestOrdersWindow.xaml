<Window x:Class="MusicBoxManagement.Wpf.Views.GuestOrdersWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Gọi món" Width="1160" Height="760" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="RowHeight" Value="36"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="Background" Value="White"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button Content="Đóng" DockPanel.Dock="Right" IsCancel="True" IsEnabled="{Binding CanClose}"/><Button x:Name="ReloadButton" Content="Tải lại" DockPanel.Dock="Right" Click="Reload_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"/></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Menu đang bán" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DataGrid x:Name="MenuTable" Grid.Row="1" ItemsSource="{Binding Menu}" SelectedItem="{Binding SelectedMenu}" IsEnabled="{Binding CanEdit}"><DataGrid.Columns>
     <DataGridTextColumn Header="Món" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="Giá (đ)" Binding="{Binding Price, StringFormat=N0}" Width="100"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,16"><TextBlock Text="Số lượng" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="QuantityInput" ItemsSource="{Binding Quantities}" SelectedItem="{Binding Quantity}" Width="70" IsEnabled="{Binding CanEdit}"/><Button x:Name="AddButton" Content="Thêm vào giỏ" Click="Add_Click" IsEnabled="{Binding CanAdd}" Margin="12,0,0,0"/></StackPanel>
    <TextBlock Grid.Row="3" Text="Giỏ đang chọn" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DataGrid x:Name="CartTable" Grid.Row="4" ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedCart}" IsEnabled="{Binding CanEdit}"><DataGrid.Columns>
     <DataGridTextColumn Header="Món" Binding="{Binding ServiceNameSnapshot}" Width="*"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="50"/><DataGridTextColumn Header="Đơn giá (đ)" Binding="{Binding UnitPrice, StringFormat=N0}" Width="110"/>
    </DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock Text="{Binding CartAmount, StringFormat='Giá trị giỏ: {0:N0} đ'}"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="RemoveButton" Content="Bỏ món đã chọn" Click="Remove_Click" IsEnabled="{Binding CanRemove}"/><Button x:Name="PreviewButton" Content="Xem trước gửi đơn" Click="Preview_Click" IsEnabled="{Binding CanPreview}" Margin="8,0,0,0"/></StackPanel></StackPanel>
   </Grid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#E9EEF0" BorderBrush="#CAD3D8" BorderThickness="1" Padding="14" Margin="0,0,0,16" Visibility="{Binding IsConfirming, Converter={StaticResource BoolVisibility}}"><StackPanel>
     <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ConfirmButton" Content="Xác nhận" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}"/><Button x:Name="KeepButton" Content="Quay lại" Click="Keep_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/></StackPanel>
    </StackPanel></Border>
    <TextBlock Grid.Row="1" Text="Đơn đã gửi trong phiên" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <DataGrid x:Name="OrdersTable" Grid.Row="2" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsEnabled="{Binding CanEdit}"><DataGrid.Columns><DataGridTextColumn Header="Đơn" Binding="{Binding OrderId}" Width="60"/><DataGridTemplateColumn Header="Trạng thái" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Đã hủy"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Pending"><Setter Property="Text" Value="Chờ phục vụ"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Text" Value="Đã phục vụ"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding OrderDetails}" TextWrapping="Wrap"/></ScrollViewer><Button x:Name="CancelOrderButton" Content="Hủy đơn đang chờ" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#5C6873"/>
 </Grid>
</Window>
