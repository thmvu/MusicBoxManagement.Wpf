<Window x:Class="MusicBoxManagement.Wpf.Views.GuestBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Box — Đặt phòng" Width="1140" Height="760" MinWidth="1000" MinHeight="640" Language="vi-VN"
        FontFamily="Segoe UI" FontSize="14" Background="#F2F4F5" WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Làm mới phòng" Click="Refresh_Click" IsEnabled="{Binding CanInput}"/>
                <Button x:Name="NewButton" Content="Đặt lượt mới" Click="New_Click" IsEnabled="{Binding CanReset}" Margin="8,0,0,0"/>
                <Button Content="Đóng" IsCancel="True" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding FormTitle}" FontSize="28" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="Giờ Việt Nam · Mở cửa 09:00–12:00 và 13:00–23:00 · Không thu cọc" Foreground="#5C6873" Margin="0,12,0,20" TextWrapping="Wrap"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="RoomsTable" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" SelectionChanged="Room_Changed"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" IsEnabled="{Binding CanInput}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#E9EEF0"/></Style>
                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding RoomCode}" Width="75"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding TypeName}" Width="100"/>
                        <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity, StringFormat={}{0} người}" Width="85"/>
                        <DataGridTextColumn Header="Giá / giờ" Binding="{Binding PricePerHour, StringFormat={}{0:N0} đ}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Image x:Name="RoomImage" Grid.Row="1" Stretch="Uniform" Margin="0,14,0,0"/>
                <ScrollViewer Grid.Row="2" MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="RoomDetails" TextWrapping="Wrap" Foreground="#5C6873"/>
                </ScrollViewer>
            </Grid>
            <ScrollViewer Grid.Column="1" Margin="24,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel IsEnabled="{Binding CanInput}">
                        <TextBlock Text="Thông tin đặt phòng" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Ngày sử dụng" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DateInput" SelectedDate="{Binding SelectedDate}" DisplayDateStart="{Binding FirstDate, Mode=OneWay}" DisplayDateEnd="{Binding LastDate, Mode=OneWay}"/>
                        <TextBlock Text="Giờ bắt đầu" Margin="0,12,0,6"/>
                        <ComboBox x:Name="TimeInput" ItemsSource="{Binding Slots}" SelectedItem="{Binding StartTimeText}" Padding="8"/>
                        <TextBlock Text="Thời lượng (phút)" Margin="0,12,0,6"/>
                        <ComboBox x:Name="DurationInput" ItemsSource="{Binding Durations}" SelectedItem="{Binding Duration}" Padding="8"/>
                        <TextBlock Text="Họ tên" Margin="0,12,0,6"/>
                        <TextBox x:Name="NameInput" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8"/>
                        <TextBlock Text="Số điện thoại" Margin="0,12,0,6"/>
                        <TextBox x:Name="PhoneInput" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8"/>
                    </StackPanel>
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="PreviewButton" Content="Kiểm tra giờ" Click="Preview_Click" IsEnabled="{Binding CanBook}" Margin="0,0,8,8"/>
                        <Button x:Name="SubmitButton" Content="Xác nhận đặt" Click="Submit_Click" IsEnabled="{Binding CanBook}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Foreground="#3D4D58" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#3D4D58" Margin="0,18,0,0"/>
    </Grid>
</Window>
