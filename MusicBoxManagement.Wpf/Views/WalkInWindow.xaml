<Window x:Class="MusicBoxManagement.Wpf.Views.WalkInWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Khách trực tiếp" Width="1060" Height="730" MinWidth="920" MinHeight="610"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Nhận khách trực tiếp" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Khách đến dùng ngay · Không tạo booking hoặc chọn thời lượng" Foreground="#5C6873" Margin="0,8,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="RoomsTable" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" IsEnabled="{Binding CanInput}" Margin="0,0,24,0"
    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="42" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
    <DataGrid.Resources>
     <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E9EEF0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
     <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
     <Style TargetType="TextBlock"><Setter Property="Margin" Value="10,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </DataGrid.Resources>
    <DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding RoomCode}" Width="75"/><DataGridTextColumn Header="Phòng" Binding="{Binding Name}" Width="*"/>
     <DataGridTextColumn Header="Loại" Binding="{Binding TypeName}" Width="95"/><DataGridTextColumn Header="Giá / giờ" Binding="{Binding PricePerHour, StringFormat={}{0:N0} đ}" Width="110"/></DataGrid.Columns>
   </DataGrid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <StackPanel IsEnabled="{Binding CanInput}"><TextBlock Text="Họ tên khách"/><TextBox x:Name="NameInput" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="8" Margin="0,6,0,16"/>
     <TextBlock Text="Số điện thoại"/><TextBox x:Name="PhoneInput" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,6,0,16"/></StackPanel>
    <TextBlock Text="SĐT đã có sẽ dùng khách cũ và giữ tên đã lưu. Phòng đang mở vẫn có thể bận; hệ thống kiểm tra trước và lúc nhận." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,0,0,16"/>
    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" LineHeight="24"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,18,0,16"/>
  <WrapPanel Grid.Row="3">
   <Button x:Name="RefreshButton" Content="Cập nhật" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" Margin="0,0,8,8"/>
   <Button x:Name="ReceiveButton" Content="Nhận khách" IsEnabled="{Binding CanReceive}" Click="Receive_Click" Margin="0,0,8,8"/>
   <Button x:Name="ConfirmButton" Content="Xác nhận nhận ngay" IsEnabled="{Binding CanConfirm}" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" Click="Confirm_Click" Margin="0,0,8,8"/>
   <Button x:Name="KeepButton" Content="Chỉnh lại" IsEnabled="{Binding CanConfirm}" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" Click="Keep_Click" Margin="0,0,8,8"/>
   <Button x:Name="NewButton" Content="Nhận lượt mới" IsEnabled="{Binding CanNew}" Click="New_Click" Margin="0,0,8,8"/>
   <Button Content="Đóng" IsEnabled="{Binding CanClose}" Click="Close_Click" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
</Window>
