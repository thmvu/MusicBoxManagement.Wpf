<Window x:Class="MusicBoxManagement.Wpf.Views.GuestLookupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Tra cứu SĐT" Width="1040" Height="690" MinWidth="920" MinHeight="560"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" IsEnabled="{Binding CanClose}"/><TextBlock Text="Tra cứu SĐT" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,16,0,20">
   <TextBlock Text="Nhập SĐT để xem booking còn hiệu lực và phiên đang sử dụng của bạn." Foreground="#5C6873" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <DockPanel IsEnabled="{Binding CanSearch}"><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Tra cứu" Click="Search_Click" Margin="12,0,0,0"/><TextBox x:Name="PhoneInput" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="8"/></DockPanel>
  </StackPanel>
  <TabControl x:Name="LookupTabs" Grid.Row="2" Grid.RowSpan="2" Background="White" BorderBrush="#CAD3D8" Padding="16">
   <TabItem Header="Booking">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DataGrid x:Name="ReservationsTable" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSearch}"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
   RowHeight="44" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
   <DataGrid.Resources>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#E9EEF0"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Mã booking" Binding="{Binding ReservationId}" Width="100"/>
    <DataGridTextColumn Header="Mã phòng" Binding="{Binding RoomCode}" Width="90"/>
    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomName}" Width="*" MinWidth="140"/>
    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartLabel}" Width="190"/>
    <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndLabel}" Width="190"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="1" Margin="0,16,0,0">
   <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
   <Button x:Name="CancelButton" Content="Hủy booking đã chọn" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirming, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
    <Button x:Name="ConfirmButton" Content="Đồng ý hủy" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}"/>
    <Button x:Name="KeepButton" Content="Giữ booking" Click="Keep_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Đang sử dụng">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="4,8,4,12">
      <TextBlock Text="Phiên đang sử dụng" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
      <TextBlock x:Name="SessionDetailsText" Text="{Binding SessionDetails}" TextWrapping="Wrap" LineHeight="24"/>
      <Button x:Name="OrdersButton" Content="Gọi món / xem đơn" Click="Orders_Click" IsEnabled="{Binding CanOpenOrders}" Visibility="{Binding HasActiveSession, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding ShowExtensionControls, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="Thêm thời gian (phút)" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <ComboBox x:Name="ExtensionMinutesInput" ItemsSource="{Binding ExtensionChoices}" SelectedItem="{Binding ExtensionMinutes}" Width="90" IsEnabled="{Binding CanExtend}"/>
       <Button x:Name="PreviewExtensionButton" Content="Xem trước gia hạn" Click="PreviewExtension_Click" IsEnabled="{Binding CanExtend}" Margin="12,0,0,0"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Width="360" Margin="16,8,0,0" Visibility="{Binding IsExtensionConfirming, Converter={StaticResource BoolVisibility}}">
      <Border BorderBrush="#CAD3D8" BorderThickness="1" Background="#E9EEF0" Padding="16" VerticalAlignment="Top">
       <StackPanel>
        <TextBlock Text="{Binding ExtensionDetails}" TextWrapping="Wrap" LineHeight="24"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
         <Button x:Name="ConfirmExtensionButton" Content="Xác nhận gia hạn" Click="ConfirmExtension_Click" IsEnabled="{Binding CanConfirmExtension}"/>
         <Button x:Name="KeepSessionButton" Content="Giữ giờ trả" Click="KeepSession_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/>
        </StackPanel>
       </StackPanel>
      </Border>
    </ScrollViewer>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="StatusText" Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,16,0,0"/>
 </Grid>
</Window>
