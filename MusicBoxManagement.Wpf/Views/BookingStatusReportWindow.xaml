<Window x:Class="MusicBoxManagement.Wpf.Views.BookingStatusReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Báo cáo đặt phòng" Width="1100" Height="740" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#F2F4F5" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Loaded="Window_Loaded">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ExportButton" Content="Xuất Excel" IsEnabled="{Binding CanExport}" Click="Export_Click" Margin="0,0,12,0"/><Button x:Name="CloseButton" Content="Đóng" Click="Close_Click"/></StackPanel><TextBlock Text="Báo cáo đặt phòng" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanSearch}">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Từ ngày (giờ Việt Nam)"/><DatePicker x:Name="FromInput" SelectedDate="{Binding FromDate}" Width="180" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToInput" SelectedDate="{Binding ToDate}" Width="180" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <Button x:Name="SearchButton" Content="Xem báo cáo" Click="Search_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <Border Grid.Row="2" Background="White" BorderBrush="#CAD3D8" BorderThickness="1" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="SummaryText" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#263D4A" MinHeight="20"/></Border>
  <DataGrid Grid.Row="3" x:Name="ReportTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
   <DataGrid.Columns><DataGridTextColumn Header="Trạng thái tại thời điểm cập nhật" Binding="{Binding Label}" Width="*" MinWidth="300"/><DataGridTextColumn Header="Số lượt đặt phòng" Binding="{Binding Count,StringFormat={}{0:N0}}" Width="220"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0">
   <TextBlock Text="Lọc theo giờ bắt đầu đặt phòng, không phải ngày tạo hoặc ngày thanh toán." TextWrapping="Wrap" Foreground="#41535F"/>
   <TextBlock Text="Booking đã xác nhận nhưng hết hạn nhận phòng (+15 phút) được tính là Không đến, kể cả khi tác vụ cập nhật chưa chạy. Báo cáo chỉ đọc dữ liệu." TextWrapping="Wrap" Foreground="#41535F" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#263D4A"/>
  </StackPanel>
 </Grid>
</Window>
