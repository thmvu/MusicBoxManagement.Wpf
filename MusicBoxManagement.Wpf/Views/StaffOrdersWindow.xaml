<Window x:Class="MusicBoxManagement.Wpf.Views.StaffOrdersWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Đơn món" Width="1080" Height="700" MinWidth="980" MinHeight="600" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button Content="Đóng" DockPanel.Dock="Right" IsCancel="True" IsEnabled="{Binding CanClose}"/><Button x:Name="ReloadButton" Content="Tải lại" DockPanel.Dock="Right" Click="Reload_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/><TextBlock Text="Đơn món" FontSize="26" FontWeight="SemiBold"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Phiên sử dụng" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox x:Name="SessionInput" Grid.Column="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" DisplayMemberPath="Label" SelectionChanged="Session_Changed" IsEnabled="{Binding CanEdit}"/>
   <Button x:Name="CreateButton" Grid.Column="2" Content="Ghi món đã phục vụ" Click="Create_Click" IsEnabled="{Binding CanCreate}" Margin="12,0,0,0"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="OrdersTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" RowHeight="36" ColumnHeaderHeight="36" Background="White" Margin="0,0,20,0" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" IsEnabled="{Binding CanSelectOrder}">
    <DataGrid.Columns><DataGridTextColumn Header="Đơn" Binding="{Binding OrderId}" Width="65"/><DataGridTemplateColumn Header="Trạng thái" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Đã hủy"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Pending"><Setter Property="Text" Value="Chờ phục vụ"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Text" Value="Đã phục vụ"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
   </DataGrid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Món trong đơn" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <WrapPanel Grid.Row="1" Margin="0,16,0,12"><Button x:Name="ServeButton" Content="Đã phục vụ" Click="Serve_Click" IsEnabled="{Binding CanServe}" Margin="0,0,8,8"/><Button x:Name="CancelButton" Content="Hủy đơn chờ" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" Margin="0,0,0,8"/></WrapPanel>
    <Border Grid.Row="2" Padding="14" Background="#E9EEF0" BorderBrush="#CAD3D8" BorderThickness="1" Visibility="{Binding IsConfirming, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ConfirmButton" Content="Xác nhận" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}"/><Button x:Name="KeepButton" Content="Quay lại" Click="Keep_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#5C6873"/>
 </Grid>
</Window>
