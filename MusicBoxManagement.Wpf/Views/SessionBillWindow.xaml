<Window x:Class="MusicBoxManagement.Wpf.Views.SessionBillWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Tiền tạm tính" Width="820" Height="650" MinWidth="720" MinHeight="560"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Tiền tạm tính" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Số tiền tại thời điểm cập nhật; tiền thanh toán sẽ được chốt khi trả phòng." Foreground="#5C6873" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Visibility="{Binding HasBill, Converter={StaticResource Visible}}">
    <TextBlock x:Name="DetailsText" Text="{Binding Details}" TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,22"/>
    <Border Background="White" BorderBrush="#CAD3D8" BorderThickness="1" Padding="20">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Tiền phòng"/><TextBlock Grid.Column="1" Text="{Binding RoomAmount}" FontWeight="SemiBold" Margin="16,0,0,0"/>
      <TextBlock Grid.Row="1" Text="Món đã phục vụ" Margin="0,14,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceAmount}" FontWeight="SemiBold" Margin="16,14,0,0"/>
      <TextBlock Grid.Row="2" Text="Tổng tạm tính" FontSize="20" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock x:Name="TotalText" Grid.Row="2" Grid.Column="1" Text="{Binding TotalAmount}" FontSize="20" FontWeight="SemiBold" Margin="16,22,0,0"/>
     </Grid>
    </Border>
    <TextBlock Text="{Binding OrdersNote}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,16,0,0" LineHeight="23"/>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,18,0,18"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="RefreshButton" Content="Cập nhật tiền" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"/>
   <Button x:Name="CloseButton" Content="Đóng" Click="Close_Click" IsEnabled="{Binding CanRefresh}" Margin="12,0,0,0"/>
  </StackPanel>
 </Grid>
</Window>
