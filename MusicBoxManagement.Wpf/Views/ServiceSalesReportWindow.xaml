<Window x:Class="MusicBoxManagement.Wpf.Views.ServiceSalesReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Doanh thu và top món" Width="1160" Height="760" MinWidth="960" MinHeight="640"
 WindowStartupLocation="CenterOwner" Background="#F2F4F5" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Loaded="Window_Loaded">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ExportButton" Content="Xuất Excel" IsEnabled="{Binding CanExport}" Click="Export_Click" Margin="0,0,12,0"/><Button x:Name="CloseButton" Content="Đóng" Click="Close_Click"/></StackPanel><TextBlock Text="Doanh thu và top món" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanSearch}">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Từ ngày (giờ Việt Nam)"/><DatePicker x:Name="FromInput" SelectedDate="{Binding FromDate}" Width="160" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToInput" SelectedDate="{Binding ToDate}" Width="160" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Dịch vụ (gồm ngừng bán)"/><ComboBox x:Name="ServiceInput" ItemsSource="{Binding Services}" DisplayMemberPath="Label" SelectedValuePath="ServiceId" SelectedValue="{Binding SelectedServiceId}" Width="250" Padding="5" Margin="0,6,0,0"/></StackPanel>
   <Button x:Name="SearchButton" Content="Xem báo cáo" Click="Search_Click" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <Border Grid.Row="2" Background="White" BorderBrush="#CAD3D8" BorderThickness="1" Padding="12" Margin="0,0,0,12"><TextBlock x:Name="SummaryText" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#263D4A" MinHeight="20"/></Border>
  <TabControl Grid.Row="3" x:Name="ReportTabs" SelectedIndex="{Binding SelectedTab,Mode=TwoWay}" IsEnabled="{Binding CanSearch}">
   <TabItem Header="Doanh thu theo món">
    <DataGrid x:Name="ReportTable" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="40" Background="White" GridLinesVisibility="Horizontal">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Mã dịch vụ" Binding="{Binding ServiceId}" Width="100"/>
      <DataGridTextColumn Header="Tên món đã bán" Binding="{Binding Name}" Width="*" MinWidth="220"/>
      <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity,StringFormat={}{0:N0}}" Width="130"/>
      <DataGridTextColumn Header="Doanh thu (đ)" Binding="{Binding Revenue,StringFormat={}{0:N0}}" Width="210"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Top 10 theo số lượng">
    <DataGrid x:Name="TopTable" ItemsSource="{Binding TopItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="42" ColumnHeaderHeight="40" Background="White" GridLinesVisibility="Horizontal">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Mã dịch vụ" Binding="{Binding ServiceId}" Width="100"/>
      <DataGridTextColumn Header="Tên món đã bán" Binding="{Binding Name}" Width="*" MinWidth="220"/>
      <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity,StringFormat={}{0:N0}}" Width="130"/>
      <DataGridTextColumn Header="Doanh thu (đ)" Binding="{Binding Revenue,StringFormat={}{0:N0}}" Width="210"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Margin="0,12,0,0">
   <TextBlock Text="Lọc theo ngày thanh toán hóa đơn. Chỉ tính món đã hoàn tất của phiên có hóa đơn; giá lấy từ món đã bán." TextWrapping="Wrap" Foreground="#41535F"/>
   <TextBlock Text="Nhóm theo mã dịch vụ; tên hiển thị là snapshot gần nhất trong kỳ. Top món xếp theo số lượng, rồi doanh thu và mã." TextWrapping="Wrap" Foreground="#41535F" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#263D4A"/>
  </StackPanel>
 </Grid>
</Window>
