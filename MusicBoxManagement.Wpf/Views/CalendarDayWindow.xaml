<Window x:Class="MusicBoxManagement.Wpf.Views.CalendarDayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Lịch phòng" Width="1420" Height="850" MinWidth="1050" MinHeight="660"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="{StaticResource MusicPaperBrush}"
 Loaded="Loaded_Window" Closing="Closing_Window">
 <Window.Resources>
  <Style x:Key="ModeChoice" TargetType="RadioButton"><Setter Property="Padding" Value="16,9"/><Setter Property="Foreground" Value="{StaticResource MusicInkBrush}"/><Setter Property="Background" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource MusicInkBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource MusicBrassBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TimelineEventButton" TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Block" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" ClipToBounds="True"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Block" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Block" Property="BorderThickness" Value="2"/><Setter TargetName="Block" Property="BorderBrush" Value="{StaticResource MusicBrassBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="MonthDay" TargetType="CalendarDayButton"><Setter Property="FontSize" Value="13"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton"><Border x:Name="DayFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14"><TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsToday" Value="True"><Setter TargetName="DayFrame" Property="BorderBrush" Value="{StaticResource MusicBrassBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DayFrame" Property="Background" Value="{StaticResource MusicPaperBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="DayFrame" Property="Background" Value="{StaticResource MusicAccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DayFrame" Property="BorderBrush" Value="{StaticResource MusicInkBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" IsEnabled="{Binding CanLoad}"/><StackPanel><TextBlock Text="Lịch trình phòng" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Heading}" Foreground="{StaticResource MusicMutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
  <WrapPanel Grid.Row="1" IsEnabled="{Binding CanLoad}" Margin="0,0,0,16">
   <RadioButton x:Name="DayMode" Content="Ngày" GroupName="CalendarMode" Style="{StaticResource ModeChoice}" IsChecked="{Binding IsDay, Mode=OneWay}" Click="Day_Click" Margin="0,0,4,8"/>
   <RadioButton x:Name="WeekMode" Content="Tuần" GroupName="CalendarMode" Style="{StaticResource ModeChoice}" IsChecked="{Binding IsWeek, Mode=OneWay}" Click="Week_Click" Margin="0,0,16,8"/>
   <DatePicker x:Name="DateInput" SelectedDate="{Binding Date}" Width="145" VerticalAlignment="Center" Margin="0,0,12,8"/>
   <ComboBox x:Name="RoomInput" ItemsSource="{Binding RoomChoices}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Label" Width="220" SelectionChanged="Room_Changed" Margin="0,0,16,8" AutomationProperties.Name="Phòng cần xem"/>
   <Button x:Name="PreviousButton" Content="Trước" Click="Previous_Click" Margin="0,0,6,8" ToolTip="{Binding PreviousLabel}"/><Button x:Name="TodayButton" Content="Hôm nay" Click="Today_Click" Margin="0,0,6,8"/><Button x:Name="NextButton" Content="Sau" Click="Next_Click" Margin="0,0,16,8" ToolTip="{Binding NextLabel}"/><Button x:Name="LoadButton" Content="Tải lại lịch" Click="Load_Click" Margin="0,0,0,8"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
    <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#EBEEE7" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="0,0,1,1"><TextBlock Text="Giờ VN" FontSize="12" Foreground="{StaticResource MusicMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
     <Border Grid.Column="1" ClipToBounds="True" Background="#EBEEE7"><Canvas x:Name="TimelineHeaders"><Canvas.RenderTransform><TranslateTransform x:Name="HeaderOffset"/></Canvas.RenderTransform></Canvas></Border>
     <Border Grid.Row="1" ClipToBounds="True" Background="White" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="0,0,1,0"><Canvas x:Name="TimeRuler"><Canvas.RenderTransform><TranslateTransform x:Name="RulerOffset"/></Canvas.RenderTransform></Canvas></Border>
     <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ScrollChanged="Timeline_Scrolled" SizeChanged="Timeline_Resized"><Canvas x:Name="Timeline" Background="White"/></ScrollViewer>
    </Grid>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="White" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="1" CornerRadius="5" Padding="10"><StackPanel><TextBlock Text="Chọn ngày" FontSize="16" FontWeight="SemiBold" Margin="8,4,0,10"/><Calendar CalendarDayButtonStyle="{StaticResource MonthDay}" x:Name="MonthCalendar" FirstDayOfWeek="Monday" SelectedDate="{Binding Date, Mode=TwoWay}" DisplayDate="{Binding Date, Mode=OneWay}" SelectedDatesChanged="Month_Changed" IsEnabled="{Binding CanLoad}" BorderThickness="0" FontSize="14"></Calendar></StackPanel></Border>
    <WrapPanel Margin="0,16,0,12"><TextBlock Text="● Đã đặt" Foreground="#516C86" Margin="0,0,14,6"/><TextBlock Text="● Đang dùng" Foreground="#51634E" Margin="0,0,0,6"/><TextBlock Text="● Hoàn tất" Foreground="#737B77" Margin="0,0,14,6"/><TextBlock Text="● Quá giờ" Foreground="#955D35"/></WrapPanel>
    <Border Background="White" BorderBrush="{StaticResource MusicLineBrush}" BorderThickness="1" CornerRadius="5" Padding="16"><StackPanel><TextBlock Text="Lượt đã chọn" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="DetailsText" Text="{Binding Details}" TextWrapping="Wrap"/><TextBlock Text="Trạng thái phòng hiện tại" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="{Binding CurrentRoomsStatus}" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="09:00–23:00 · Nghỉ 12:00–13:00. Chọn khối lịch để xem chi tiết. Phần viền đứt là thời gian dự kiến; quá giờ không tự kết thúc phiên." TextWrapping="Wrap" Foreground="{StaticResource MusicMutedBrush}" FontSize="12" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="{Binding Status}" Foreground="{StaticResource MusicMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12"/>
 </Grid>
</Window>
