<Window x:Class="MusicBoxManagement.Wpf.Views.CalendarDayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Lịch phòng" Width="1260" Height="820" MinWidth="1050" MinHeight="660"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5"
 Loaded="Loaded_Window" Closing="Closing_Window">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" IsEnabled="{Binding CanLoad}"/><TextBlock Text="{Binding Heading}" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,16,0,16">
   <WrapPanel IsEnabled="{Binding CanLoad}">
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Chế độ"/><StackPanel Orientation="Horizontal" Margin="0,9,0,6"><RadioButton x:Name="DayMode" Content="Ngày" GroupName="CalendarMode" IsChecked="{Binding IsDay, Mode=OneWay}" Click="Day_Click" Margin="0,0,10,0"/><RadioButton x:Name="WeekMode" Content="Tuần" GroupName="CalendarMode" IsChecked="{Binding IsWeek, Mode=OneWay}" Click="Week_Click"/></StackPanel></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Ngày xem"/><DatePicker x:Name="DateInput" SelectedDate="{Binding Date}" Width="150"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Phòng"/><ComboBox x:Name="RoomInput" ItemsSource="{Binding RoomChoices}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Label" Width="230" Padding="6"/></StackPanel>
    <Button x:Name="PreviousButton" Content="{Binding PreviousLabel}" Click="Previous_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    <Button x:Name="TodayButton" Content="Hôm nay" Click="Today_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    <Button x:Name="NextButton" Content="{Binding NextLabel}" Click="Next_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
    <Button x:Name="LoadButton" Content="Tải lịch" Click="Load_Click" VerticalAlignment="Bottom"/>
   </WrapPanel>
   <TextBlock Text="Đã đặt: xanh nhạt   ·   Đã sử dụng: xanh đậm   ·   Dự kiến: viền nét đứt   ·   Hoàn tất: xám   ·   Quá giờ: viền nâu" Foreground="#5C6873" TextWrapping="Wrap" Margin="0,12,0,4"/>
   <TextBlock Text="Giờ Việt Nam. Lịch hiển thị 09:00–23:00; giờ nghỉ 12:00–13:00. Chọn một lượt để xem giờ thực tế và cảnh báo." Foreground="#5C6873" TextWrapping="Wrap"/>
   <TextBlock Text="Ở chế độ Tuần: chọn một ngày trong tuần cần xem; cuộn ngang để xem đủ thứ Hai–Chủ nhật. Mỗi lượt có mã phòng." Foreground="#5C6873" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#CAD3D8" BorderThickness="1" Background="White">
    <ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
     <Canvas x:Name="Timeline" Background="White"/>
    </ScrollViewer>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Chi tiết lượt" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock x:Name="DetailsText" Text="{Binding Details}" TextWrapping="Wrap"/>
    <TextBlock Text="Trạng thái hiện tại" FontWeight="SemiBold" Margin="0,20,0,6"/><TextBlock Text="{Binding CurrentRoomsStatus}" TextWrapping="Wrap"/>
    <TextBlock Text="Trạng thái hiện tại không tô kín lịch tương lai. Phiên quá giờ không tự kéo dài phần dự kiến. Lịch được cập nhật khi tải lại." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,24,0,0"/>
    <TextBlock Text="Lượt có thời gian ngoài 09:00–23:00 chỉ vẽ phần trong khung. Chi tiết giữ nguyên giờ thực tế." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="StatusText" Text="{Binding Status}" Foreground="#5C6873" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </Grid>
</Window>
