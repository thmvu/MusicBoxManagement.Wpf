<Window x:Class="MusicBoxManagement.Wpf.Views.GuestCalendarWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Trống/bận theo ngày" Width="670" Height="740" MinWidth="600" MinHeight="580" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5" Closing="Closing_Window">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Trống/bận theo ngày" FontSize="26" FontWeight="SemiBold"/>
  <StackPanel Grid.Row="1" Margin="0,12,0,16"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Giờ Việt Nam · 09:00–12:00 và 13:00–23:00. Kết quả theo lịch của phòng và thời lượng đã chọn; lịch riêng của bạn được kiểm tra khi nhập SĐT và đặt." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,10,0,0"/>
  </StackPanel>
  <DataGrid x:Name="SlotsTable" Grid.Row="2" ItemsSource="{Binding Slots}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanClose}"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
   RowHeight="34" ColumnHeaderHeight="38" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
   <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#E9EEF0"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="10,0"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#F0F2F3"/><Style.Triggers><DataTrigger Binding="{Binding CanChoose}" Value="True"><Setter Property="Background" Value="#DCE8E2"/></DataTrigger></Style.Triggers></Style>
   </DataGrid.Resources>
   <DataGrid.Columns><DataGridTextColumn Header="Bắt đầu" Binding="{Binding TimeLabel}" Width="140"/><DataGridTextColumn Header="Khoảng đặt" Binding="{Binding StateLabel}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="ChooseButton" Content="Chọn giờ này" Click="Choose_Click" IsEnabled="{Binding CanChoose}"/><Button x:Name="RefreshButton" Content="Tải lại lịch" Click="Refresh_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/><Button Content="Đóng" IsCancel="True" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/></WrapPanel>
  <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,14,0,0"/>
 </Grid>
</Window>
