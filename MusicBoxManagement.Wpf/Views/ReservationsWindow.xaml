<Window x:Class="MusicBoxManagement.Wpf.Views.ReservationsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Box — Booking nội bộ" Width="1240" Height="760" MinWidth="1100" MinHeight="660"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Language="vi-VN" Background="#F2F4F5">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button DockPanel.Dock="Right" Content="Đóng" IsCancel="True" IsEnabled="{Binding CanClose}"/><TextBlock Text="Booking nội bộ" FontSize="28" FontWeight="SemiBold"/></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,16,0,20" IsEnabled="{Binding CanSearch}">
   <TextBlock Text="Xem booking và hủy Confirmed còn hạn trước check-in. Hủy bắt buộc nhập lý do." TextWrapping="Wrap" Foreground="#5C6873" Margin="0,0,0,12"/>
   <WrapPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Từ ngày"/><DatePicker x:Name="FromInput" SelectedDate="{Binding FromDate}" Width="145"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToInput" SelectedDate="{Binding ToDate}" Width="145"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="SĐT đầy đủ (có thể bỏ trống)"/><TextBox x:Name="PhoneInput" Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}" Width="240" MaxLength="50" Padding="6"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="Trạng thái"/><ComboBox x:Name="StateInput" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusQuery}" Width="140" Padding="6"/></StackPanel>
    <Button x:Name="SearchButton" Content="Tải danh sách" Click="Search_Click" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="ReservationsTable" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelect}"
    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column"
    RowHeight="48" ColumnHeaderHeight="40" Background="White" BorderBrush="#CAD3D8" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DEE4E7">
    <DataGrid.Resources>
     <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#E9EEF0"/></Style>
     <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
    </DataGrid.Resources>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Mã" Binding="{Binding ReservationId}" Width="55"/>
     <DataGridTextColumn Header="Phòng" Binding="{Binding RoomCode}" Width="75"/>
     <DataGridTextColumn Header="Khách" Binding="{Binding CustomerName}" Width="*" MinWidth="120"/>
     <DataGridTextColumn Header="SĐT" Binding="{Binding PhoneNumber}" Width="120"/>
     <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartLabel}" Width="165"/>
     <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
    </DataGrid.Columns>
   </DataGrid>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Chi tiết booking" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
    </StackPanel>
    </ScrollViewer>
     <Button Grid.Row="1" x:Name="CancelButton" Content="Hủy booking đã chọn" Click="Cancel_Click" IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     <StackPanel Grid.Row="2" Visibility="{Binding IsConfirming, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
      <TextBlock Text="Lý do hủy (bắt buộc)"/>
      <TextBox x:Name="ReasonInput" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfirm}" Padding="8" Margin="0,6,0,12"/>
      <WrapPanel><Button x:Name="ConfirmButton" Content="Xác nhận hủy" Click="Confirm_Click" IsEnabled="{Binding CanConfirm}"/><Button x:Name="KeepButton" Content="Giữ booking" Click="Keep_Click" IsEnabled="{Binding CanClose}" Margin="8,0,0,0"/></WrapPanel>
     </StackPanel>
   </Grid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#5C6873" Margin="0,18,0,0"/>
 </Grid>
</Window>
