digraph MusicBox {
graph [rankdir=LR, bgcolor="#fbfaf7", pad="0.3", nodesep="0.35", ranksep="0.9", splines=polyline];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#72826d", arrowsize=0.7];
"RoomTypes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>RoomTypes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">RoomTypeId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">Code</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">Capacity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PricePerHour</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">Amenities</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD></TR><TR><TD ALIGN="LEFT">Description</TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR></TABLE>>];
"AspNetUsers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>AspNetUsers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id PK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">UserName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">NormalizedUserName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">PasswordHash</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">SecurityStamp</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">FullName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">IsActive</TD><TD ALIGN="LEFT">TINYINT</TD></TR></TABLE>>];
"AspNetRoles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>AspNetRoles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id PK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR></TABLE>>];
"AspNetUserRoles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>AspNetUserRoles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">UserId PK, FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">RoleId FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR></TABLE>>];
"Permission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Permission</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PermissionId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">Code</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR></TABLE>>];
"RolePermission" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>RolePermission</B></FONT></TD></TR><TR><TD ALIGN="LEFT">RoleId PK, FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">PermissionId PK, FK</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
"AuditLog" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>AuditLog</B></FONT></TD></TR><TR><TD ALIGN="LEFT">AuditLogId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ActorType</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">UserId FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">Action</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">EntityName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">EntityId</TD><TD ALIGN="LEFT">VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">Description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">CreatedAt</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR></TABLE>>];
"Rooms" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Rooms</B></FONT></TD></TR><TR><TD ALIGN="LEFT">RoomId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">RoomCode</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">RoomTypeId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">ImageUrl</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">Description</TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">IsActive</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT">InactiveReason</TD><TD ALIGN="LEFT">VARCHAR(1000)</TD></TR><TR><TD ALIGN="LEFT">CreatedAt</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR></TABLE>>];
"Customers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CustomerId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FullName</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">PhoneNumber</TD><TD ALIGN="LEFT">VARCHAR(10)</TD></TR></TABLE>>];
"Reservations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ReservationId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">CustomerId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">RoomId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">StartTime</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR><TR><TD ALIGN="LEFT">EndTime</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">CancellationReason</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">CreatedByUserId FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">CreatedAt</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR></TABLE>>];
"RoomSessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>RoomSessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">RoomSessionId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">CustomerId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">RoomId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ReservationId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ActualStartTime</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR><TR><TD ALIGN="LEFT">ExpectedEndTime</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR><TR><TD ALIGN="LEFT">ActualEndTime</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR><TR><TD ALIGN="LEFT">HourlyRate</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">RoomCodeSnapshot</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">RoomTypeCodeSnapshot</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">RoomTypeNameSnapshot</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">ActiveRoomId</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ActiveCustomerId</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
"Services" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Services</B></FONT></TD></TR><TR><TD ALIGN="LEFT">ServiceId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">Category</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">Price</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">Description</TD><TD ALIGN="LEFT">VARCHAR(2000)</TD></TR><TR><TD ALIGN="LEFT">IsActive</TD><TD ALIGN="LEFT">TINYINT</TD></TR></TABLE>>];
"Orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT">OrderId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">RoomSessionId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">CreatedByUserId FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">CreatedAt</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR></TABLE>>];
"OrderItems" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>OrderItems</B></FONT></TD></TR><TR><TD ALIGN="LEFT">OrderItemId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">OrderId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ServiceId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">ServiceNameSnapshot</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">Quantity</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">UnitPrice</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
"Invoices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>Invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT">InvoiceId PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">RoomSessionId FK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">InvoiceNumber</TD><TD ALIGN="LEFT">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">RoomCharge</TD><TD ALIGN="LEFT">DECIMAL(29,0)</TD></TR><TR><TD ALIGN="LEFT">ServiceCharge</TD><TD ALIGN="LEFT">DECIMAL(29,0)</TD></TR><TR><TD ALIGN="LEFT">TotalAmount</TD><TD ALIGN="LEFT">DECIMAL(29,0)</TD></TR><TR><TD ALIGN="LEFT">PaymentMethod</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">ProcessedByUserId FK</TD><TD ALIGN="LEFT">VARCHAR(128)</TD></TR><TR><TD ALIGN="LEFT">ProcessedByNameSnapshot</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">PaidAt</TD><TD ALIGN="LEFT">VARCHAR(33)</TD></TR></TABLE>>];
"_MusicBoxSchemaVersion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" COLOR="#465344" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#344238"><FONT COLOR="white"><B>_MusicBoxSchemaVersion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Id PK</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">Version</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
"AspNetUsers" -> "AspNetUserRoles" [label="UserId"];
"AspNetRoles" -> "AspNetUserRoles" [label="RoleId"];
"AspNetRoles" -> "RolePermission" [label="RoleId"];
"Permission" -> "RolePermission" [label="PermissionId"];
"AspNetUsers" -> "AuditLog" [label="UserId"];
"RoomTypes" -> "Rooms" [label="RoomTypeId"];
"Customers" -> "Reservations" [label="CustomerId"];
"Rooms" -> "Reservations" [label="RoomId"];
"AspNetUsers" -> "Reservations" [label="CreatedByUserId"];
"Customers" -> "RoomSessions" [label="CustomerId"];
"Rooms" -> "RoomSessions" [label="RoomId"];
"Reservations" -> "RoomSessions" [label="ReservationId"];
"RoomSessions" -> "Orders" [label="RoomSessionId"];
"AspNetUsers" -> "Orders" [label="CreatedByUserId"];
"Orders" -> "OrderItems" [label="OrderId"];
"Services" -> "OrderItems" [label="ServiceId"];
"RoomSessions" -> "Invoices" [label="RoomSessionId"];
"AspNetUsers" -> "Invoices" [label="ProcessedByUserId"];
}
